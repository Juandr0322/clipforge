# Copy this file to .env and fill in your own values. .env is git-ignored.
ANTHROPIC_API_KEY=

# Optional engine overrides
# CLIPFORGE_ASR=whisper:small      # whisper:small | whisper:medium | mock
# CLIPFORGE_HL=anthropic           # anthropic | mock
# CLIPFORGE_DETECTOR=mediapipe     # mediapipe | haar
# CLIPFORGE_EXAMPLES=examples

# Optional: passed as the Anthropic SDK workspace_id argument (value is never logged)
# ANTHROPIC_WORKSPACE_ID=

# Originality layer (render stage). Flags: 1/0. Defaults: overlay and punch-in on, end card off.
# CLIPFORGE_CONTEXT_OVERLAY=1     # show the clip's context line at the top for the first 3.5 s
# CLIPFORGE_PUNCH_IN=1            # zoom in on the reaction peak
# CLIPFORGE_END_CARD=0            # append an end card after the clip
# CLIPFORGE_END_CARD_SEC=2        # end card length in seconds (max 10)
# CLIPFORGE_END_CARD_TEXT="Follow for more"
