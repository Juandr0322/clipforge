# Copy this file to .env and fill in your own values. .env is git-ignored.
ANTHROPIC_API_KEY=

# Optional engine overrides
# CLIPFORGE_ASR=whisper:small      # whisper:small | whisper:medium | mock
# CLIPFORGE_HL=anthropic           # anthropic | mock
# CLIPFORGE_DETECTOR=mediapipe     # mediapipe | haar
# CLIPFORGE_EXAMPLES=examples
# CLIPFORGE_RECIPE=talk            # talk | gaming | storytime | talking_head | cinematic | day_in_life (clipforge/recipes/files)

# Optional: passed as the Anthropic SDK workspace_id argument (value is never logged)
# ANTHROPIC_WORKSPACE_ID=

# Originality layer (render stage). Flags: 1/0. Defaults: overlay and punch-in on, end card off.
# CLIPFORGE_CONTEXT_OVERLAY=1     # show the clip's context line at the top for the first 3.5 s
# CLIPFORGE_PUNCH_IN=1            # zoom in on the reaction peak
# CLIPFORGE_END_CARD=0            # append an end card after the clip
# CLIPFORGE_END_CARD_SEC=2        # end card length in seconds (max 10)
# CLIPFORGE_END_CARD_TEXT="Follow for more"

# Audio layer (render stage): sound effects and a quiet music bed mixed ON TOP of the
# original audio, never replacing it. Levels are dB relative to the clip's own level.
# Library: a folder with library.json; fill it with `clipforge audio add` (docs/AUDIO_SOURCES.md).
# CLIPFORGE_SFX=1                  # sound effects on the clip's beats (built-in sounds if no library)
# CLIPFORGE_MUSIC=1                # music bed (only when the library has a cleared track)
# CLIPFORGE_AUDIO_LIBRARY=~/clipforge-audio
# CLIPFORGE_SFX_LEVEL_DB=-6        # loudest moment of an effect vs the clip level (max 0)
# CLIPFORGE_MUSIC_LEVEL_DB=-20     # music vs the clip level (capped at -6)
# CLIPFORGE_MUSIC_DUCK_DB=-6       # extra drop while someone talks
# CLIPFORGE_MUSIC_TAGS=gaming      # preferred music tags, comma-separated
